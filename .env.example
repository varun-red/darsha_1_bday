# Copy to .env (or set these in your hosting dashboard).

# Port the server listens on
PORT=3000

# Password for the hosts' dashboard at /admin. CHANGE THIS.
ADMIN_PASSWORD=change-me-please

# Public URL used in invitation links, QR codes and emails (no trailing slash).
# If unset, links are built from the incoming request's host.
PUBLIC_URL=https://darsha-turns-one.example.com

# Where the SQLite database lives. Point this at a persistent disk in production.
DB_PATH=./data/party.sqlite

# Optional: send invitations, reminders and RSVP confirmations by email.
# Works with Gmail (use an App Password), Outlook, Fastmail, Resend SMTP, etc.
# Leave blank to use "Open in email app" (mailto) links instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Darsha's Parents <you@example.com>"

# Optional: override the auto-generated cookie signing secret.
SESSION_SECRET=
